{
    "openapi": "3.0.0",
    "info": {
        "title": "TP1 - Gestion de location d'équipements sportifs",
        "version": "1.0"
    },
    "paths": {
        "/api/equipment": {
            "get": {
                "tags": [
                    "Équipements"
                ],
                "summary": "Liste paginée des équipements",
                "operationId": "771e58f407e40ca413f92c85f944e760",
                "responses": {
                    "200": {
                        "description": "Liste des équipements récupérée avec succès"
                    }
                }
            }
        },
        "/api/equipment/{id}/popularity": {
            "get": {
                "tags": [
                    "Équipements"
                ],
                "summary": "Calcul de la popularité d'un équipement",
                "description": "Calcule le score de popularité d'un équipement.\n\nFormule : (nombre de locations * 0.6) + (moyenne des notes * 0.4).\n\nSources :\n- Énoncé du TP1 : formule de calcul du score de popularité.\n- OpenAI, ChatGPT : assistance à l'implémentation de la méthode\n  avec Laravel Eloquent (count, with, flatMap, pluck et avg).\n\nhttps://chatgpt.com/",
                "operationId": "f073a07513b9a2e31ca3067c2dccd504",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Identifiant de l'équipement",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Score de popularité calculé avec succès"
                    },
                    "404": {
                        "description": "Équipement introuvable"
                    }
                }
            }
        },
        "/api/equipment/{id}/average-rental-price": {
            "get": {
                "tags": [
                    "Équipements"
                ],
                "summary": "Calculer le prix moyen de location d'un équipement",
                "operationId": "daa3c2c1708c4ef4421603a05c825575",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Identifiant de l'équipement",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "minDate",
                        "in": "query",
                        "description": "Date minimale de début de location (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "maxDate",
                        "in": "query",
                        "description": "Date maximale de fin de location (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "maxTotalPrice",
                        "in": "query",
                        "description": "Prix total maximal d'une location",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Prix moyen calculé avec succès"
                    },
                    "404": {
                        "description": "Équipement introuvable"
                    },
                    "422": {
                        "description": "Paramètres de filtrage invalides"
                    }
                }
            }
        },
        "/api/users/{userId}/rentals": {
            "get": {
                "tags": [
                    "Locations"
                ],
                "summary": "Liste des locations d'un utilisateur",
                "operationId": "f622dd0af38cab98338e00626401b1a4",
                "parameters": [
                    {
                        "name": "userId",
                        "in": "path",
                        "description": "Identifiant de l'utilisateur",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste des locations récupérée avec succès"
                    },
                    "404": {
                        "description": "Utilisateur introuvable"
                    }
                }
            }
        },
        "/api/reviews/{id}": {
            "delete": {
                "tags": [
                    "Avis"
                ],
                "summary": "Supprimer un avis",
                "operationId": "89986343b5dbd2b909c2764aeb7e4096",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Identifiant de l'avis à supprimer",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Avis supprimé avec succès"
                    },
                    "404": {
                        "description": "Avis introuvable"
                    }
                }
            }
        },
        "/api/users": {
            "post": {
                "tags": [
                    "Utilisateurs"
                ],
                "summary": "Créer un utilisateur",
                "operationId": "592819a0265360b2014512d6dbfaf0e7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "firstName",
                                    "lastName",
                                    "email",
                                    "phone"
                                ],
                                "properties": {
                                    "firstName": {
                                        "type": "string",
                                        "example": "Jean",
                                        "maxLength": 50
                                    },
                                    "lastName": {
                                        "type": "string",
                                        "example": "Dupont",
                                        "maxLength": 50
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jean.dupont@example.com",
                                        "maxLength": 50
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "4185551234",
                                        "maxLength": 12
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Utilisateur créé avec succès"
                    },
                    "422": {
                        "description": "Erreur de validation des données"
                    }
                }
            }
        },
        "/api/users/{id}": {
            "put": {
                "tags": [
                    "Utilisateurs"
                ],
                "summary": "Modifier un utilisateur",
                "operationId": "b9091397c8b25f12c6adb74be6ce3a5a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Identifiant de l'utilisateur",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "firstName",
                                    "lastName",
                                    "email",
                                    "phone"
                                ],
                                "properties": {
                                    "firstName": {
                                        "type": "string",
                                        "example": "Jean",
                                        "maxLength": 50
                                    },
                                    "lastName": {
                                        "type": "string",
                                        "example": "Martin",
                                        "maxLength": 50
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jean.martin@example.com",
                                        "maxLength": 50
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "4185555678",
                                        "maxLength": 12
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Utilisateur mis à jour avec succès"
                    },
                    "404": {
                        "description": "Utilisateur introuvable"
                    },
                    "422": {
                        "description": "Erreur de validation des données"
                    }
                }
            }
        }
    },
